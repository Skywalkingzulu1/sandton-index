# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Everything here is optional -- the pipeline runs without any of it.

# G Maps Extractor -- Google Maps Scraper API (free tier: 300 req/min).
# Used to enrich records with verified phone, hours and place IDs.
# Docs: https://cloud.gmapsextractor.com/
GMAPSEXTRACTOR_TOKEN=

# Base URL for canonical tags, sitemap entries and internal links. Set this
# once a real domain is live. Defaults to the GitHub Pages project URL.
SANDTON_SITE_URL=https://skywalkingzulu1.github.io/sandton-index
