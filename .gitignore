# Generated site output. Rebuilt by 09_build_sites.py on every push.
site/

# Cached Maps API responses. Local working state: regenerable, potentially
# large, and useless on another machine (quota is per-token, not per-repo).
# This directory is the reason a re-run does not re-spend paid quota, so do
# not delete it casually -- just do not commit it.
data/_google_cache/

# Local scratch
*.bak
*.tmp
__pycache__/
*.pyc
.venv/
venv/

# Secrets. .env holds live API tokens and must never leave the machine.
# .env.example is committed and documents the shape without the values.
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
.DS_Store

# Cached OSM /map API tile responses for the property harvest.
# Same reasoning as data/_google_cache/: regenerable, large, and useless on
# another machine. Tiles are cached so a re-run does not re-hammer the API.
data/_osm_cache/

# Cached Council for Geoscience cadastral responses (about 10 MB).
# Regenerable and useless on another machine.
data/_cadastral_cache/

# Derived spatial index: 109k parcel points, 3.8 MB, rebuilt by
# 15_harvest_cadastral.py. Responses are cached in data/_cadastral_cache,
# so a re-run is cheap and works offline. Not worth 3.8 MB of history.
data/cadastral_index.json

# Node modules, only present if you install jsdom to run
# scripts/test_search_render.js. The site itself has no JS build step.
node_modules/
